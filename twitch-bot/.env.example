# Twitch Configuration
# Получить OAuth токен: https://twitchapps.com/tmi/

# Username вашего бота (например, "my_youtube_bot")
TWITCH_BOT_USERNAME=your_bot_username

# OAuth токен (должен начинаться с "oauth:")
# Получить на https://twitchapps.com/tmi/
TWITCH_OAUTH_TOKEN=oauth:your_oauth_token_here

# Название вашего Twitch канала (например, "your_channel")
TWITCH_CHANNEL=your_channel_name

# API Configuration

# URL вашего Next.js приложения
# Локально: http://localhost:3000
# Production: https://your-app.vercel.app
API_BASE_URL=http://localhost:3000

# API ключ из .env.local Next.js проекта (API_SECRET_KEY)
API_KEY=your-secret-api-key-here
